{
  "name": "lazydsh",
  "version": "0.2.0",
  "description": "A lazier terminal UI for DeepSeek Harness.",
  "keywords": [
    "agent",
    "cli",
    "deepseek",
    "dsh",
    "harness",
    "tui"
  ],
  "homepage": "https://github.com/nuskey8/lazydsh#readme",
  "bugs": {
    "url": "https://github.com/nuskey8/lazydsh/issues"
  },
  "license": "MIT",
  "author": "nuskey8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuskey8/lazydsh.git"
  },
  "bin": {
    "lazydsh": "dist/cli.mjs"
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/plugin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "vp check && vp test run",
    "start": "node src/cli.ts",
    "demo": "node scripts/demo.ts",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
